# Use one immutable release tag, never `latest`.
SYNC_SERVER_IMAGE=ghcr.io/OWNER/codex-session-sync-server:0.1.2

# Generate a value with: openssl rand -hex 32
# Keep this value private; desktop clients use it as their server bearer token.
SYNC_SERVER_TOKEN=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_TOKEN

SYNC_SERVER_MAX_OBJECT_BYTES=4294967296
SYNC_SERVER_MAX_MANIFEST_BYTES=67108864
